# Copy to .env for local Docker Compose use. Never commit real secrets.
FMCP_ENVIRONMENT=development
FMCP_DATABASE_URL=postgresql+asyncpg://forgejo_mcp:change-me@postgres:5432/forgejo_mcp
FMCP_LOG_LEVEL=INFO
FMCP_HOST=0.0.0.0
FMCP_PORT=8000
FMCP_ALLOW_INSECURE_FORGEJO_HTTP=false
FMCP_CREDENTIAL_ENCRYPTION_KEY_FILE=/absolute/path/to/credential_key
FMCP_CREDENTIAL_ENCRYPTION_KEY_VERSION=1
POSTGRES_DB=forgejo_mcp
POSTGRES_USER=forgejo_mcp
POSTGRES_PASSWORD=change-me
