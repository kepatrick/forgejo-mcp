# Copy to .env for local Docker Compose use. Never commit real secrets.
FMCP_ENVIRONMENT=development
FMCP_DATABASE_URL=postgresql+asyncpg://forgejo_mcp:change-me@postgres:5432/forgejo_mcp
FMCP_LOG_LEVEL=INFO
FMCP_HOST=0.0.0.0
FMCP_PORT=8000
FMCP_BIND_ADDRESS=127.0.0.1
FMCP_ALLOW_INSECURE_FORGEJO_HTTP=false
FMCP_ALLOW_UNVERIFIED_FORGEJO_TLS=false
# Empty means no Forgejo connection is permitted.
FMCP_FORGEJO_ALLOWED_BASE_URLS=[]
FMCP_MIGRATION_ALLOW_PRIVATE_HOSTS=false
FMCP_TRUSTED_PROXY_CIDRS=[]
FMCP_MCP_ALLOWED_ORIGINS=[]
FMCP_OAUTH_ENABLED=false
FMCP_OAUTH_ISSUER_URL=https://forge-mcp.example.com
FMCP_OAUTH_RESOURCE_URL=https://forge-mcp.example.com/mcp
FMCP_OAUTH_CIMD_ALLOWED_ORIGINS=[]
FMCP_CREDENTIAL_ENCRYPTION_KEY_FILE=/absolute/path/to/credential_key
FMCP_CREDENTIAL_ENCRYPTION_KEY_VERSION=1
POSTGRES_DB=forgejo_mcp
POSTGRES_USER=forgejo_mcp
POSTGRES_PASSWORD=change-me
