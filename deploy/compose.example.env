# Copy to deploy/.env and replace every placeholder before starting.
POSTGRES_DB=forgejo_mcp
POSTGRES_USER=forgejo_mcp
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST_PORT=5433
FMCP_HTTP_PORT=8000
FMCP_LOG_LEVEL=INFO
FMCP_LOG_FORMAT=json
FMCP_ENVIRONMENT=production
# Set false only for direct localhost testing. Use true behind production HTTPS.
FMCP_COOKIE_SECURE=false
# Keep false in production. Set true only when using the local test-forgejo profile.
FMCP_ALLOW_INSECURE_FORGEJO_HTTP=false
FMCP_CREDENTIAL_ENCRYPTION_KEY_VERSION=1
FMCP_MCP_REQUEST_MAX_BYTES=2097152
FMCP_COMMIT_MAX_FILES=100
FMCP_COMMIT_MAX_TOTAL_BYTES=10485760
FMCP_FORGEJO_CONNECT_TIMEOUT_SECONDS=5
FMCP_FORGEJO_READ_TIMEOUT_SECONDS=30
FMCP_FORGEJO_WRITE_TIMEOUT_SECONDS=30
FMCP_FORGEJO_POOL_TIMEOUT_SECONDS=5
FMCP_FORGEJO_SAFE_RETRY_ATTEMPTS=2
FMCP_MCP_RATE_LIMIT_WINDOW_SECONDS=60
FMCP_MCP_TOKEN_RATE_LIMIT_REQUESTS=120
FMCP_MCP_USER_RATE_LIMIT_REQUESTS=240
FMCP_SHUTDOWN_GRACE_PERIOD_SECONDS=30
FMCP_BOOTSTRAP_ADMIN_USERNAME=admin
# Optional absolute host paths; defaults are deploy/secrets/admin_password and credential_key.
# FMCP_ADMIN_PASSWORD_FILE=/secure/path/admin_password
# FMCP_CREDENTIAL_KEY_FILE=/secure/path/credential_key
FORGEJO_TEST_HTTP_PORT=3000
